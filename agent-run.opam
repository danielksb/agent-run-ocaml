opam-version: "2.0"
synopsis: "CLI-based LLM agent runner"
description: "CLI-based LLM agent runner supporting OpenAI and Gemini APIs"
maintainer: ["Daniel Kuschel <danielkaes@duck.com>"]
authors: ["Daniel Kuschel <danielkaes@duck.com>"]
license: "Apache-2.0"
tags: ["ai" "cli" "llm"]
homepage: "https://github.com/danielksb/agent-run-ocaml"
doc: "https://github.com/danielksb/agent-run-ocaml"
bug-reports: "https://github.com/danielksb/agent-run-ocaml/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.3"}
  "cohttp-lwt-unix" {>= "6.2"}
  "base-unix"
  "ppx_deriving_yojson" {>= "3.10"}
  "toml"
  "alcotest" {with-test}
  "bisect_ppx" {with-test & "ocaml" < "5.4"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/danielksb/agent-run-ocaml.git"
x-maintenance-intent: ["(latest)"]
